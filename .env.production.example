# ============================================================
# DealSense — Production Environment Configuration
# ============================================================
# Copy this file to .env.production and fill in your client's keys
# ============================================================

# Domain Name (Points to your server IP — Caddy auto-generates SSL)
DOMAIN=dealsense.clientdomain.com

# PostgreSQL 16 + pgvector Credentials
POSTGRES_USER=dealsense_prod
POSTGRES_PASSWORD=generate_a_random_32_char_postgres_password_here
POSTGRES_DB=dealsense_production

# Redis 7 Streaming Credentials
REDIS_PASSWORD=generate_a_random_32_char_redis_password_here

# DealSense Security & Encryption
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=generate_a_random_64_char_hex_secret_key_here
ENCRYPTION_KEY=generate_a_random_32_byte_base64_encryption_key_here

# HubSpot Integration (From Client's HubSpot Developer App)
HUBSPOT_CLIENT_ID=your_hubspot_app_client_id
HUBSPOT_CLIENT_SECRET=your_hubspot_app_client_secret
HUBSPOT_REDIRECT_URI=https://dealsense.clientdomain.com/api/v1/auth/hubspot/callback
HUBSPOT_CLIENT_SECRET_HASH_KEY=your_hubspot_webhook_v3_verification_secret

# AI LLM Provider (For LangGraph Dossier Synthesis)
OPENAI_API_KEY=sk-your_openai_or_deepseek_api_key_here
ANTHROPIC_API_KEY=sk-ant-your_anthropic_api_key_here
