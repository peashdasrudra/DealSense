# ============================================================
# DealSense — Environment Configuration
# ============================================================
# Copy this file to .env and fill in all required values.
# Never commit .env to version control.
# ============================================================

# ---- Application ----
APP_NAME=dealsense
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO
SECRET_KEY=change-me-to-a-random-secret-key-min-32-chars

# ---- API Server ----
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ---- PostgreSQL ----
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=dealsense
POSTGRES_PASSWORD=dealsense_dev_password
POSTGRES_DB=dealsense
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}
# Sync URL for Alembic migrations
DATABASE_URL_SYNC=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# ---- Redis ----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_URL=redis://${REDIS_HOST}:${REDIS_PORT}/${REDIS_DB}

# ---- HubSpot OAuth ----
HUBSPOT_CLIENT_ID=your-hubspot-client-id
HUBSPOT_CLIENT_SECRET=your-hubspot-client-secret
HUBSPOT_REDIRECT_URI=http://localhost:8000/api/v1/oauth/callback
HUBSPOT_SCOPES=crm.objects.deals.read,crm.objects.deals.write,crm.objects.contacts.read,crm.objects.companies.read
HUBSPOT_APP_ID=your-hubspot-app-id

# ---- Encryption ----
# Fernet encryption key for OAuth tokens — generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=change-me-generate-a-real-fernet-key

# ---- LLM Provider ----
OPENAI_API_KEY=your-openai-api-key
LLM_MODEL=gpt-4o
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=4096

# ---- Embedding ----
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# ---- Worker ----
WORKER_CONCURRENCY=4
WORKER_QUEUE_NAME=dealsense:events

# ---- Observability ----
OTEL_SERVICE_NAME=dealsense-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
